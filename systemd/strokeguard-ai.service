[Unit]
Description=StrokeGuard AI Edge Runtime
After=arduino-router.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=strokeguard
WorkingDirectory=/opt/strokeguard
Environment=PYTHONPATH=/opt/strokeguard/src
EnvironmentFile=-/opt/strokeguard/.env
ExecStart=/opt/strokeguard/.venv/bin/python /opt/strokeguard/scripts/run_engine.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
