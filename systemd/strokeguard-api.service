[Unit]
Description=StrokeGuard AI Local API
After=network-online.target strokeguard-ai.service
Wants=network-online.target

[Service]
Type=simple
User=strokeguard
WorkingDirectory=/opt/strokeguard
Environment=PYTHONPATH=/opt/strokeguard/src
EnvironmentFile=-/opt/strokeguard/.env
ExecStart=/opt/strokeguard/.venv/bin/uvicorn strokeguard.api.server:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
